[caddy]
${caddy_name} ansible_host=${caddy_ip}

[dns]
${dns_name} ansible_host=${dns_ip}

# The self-hosted GitHub Actions runner (docs/RUNNER.md).
[github_runner]
${runner_name} ansible_host=${runner_ip}

# Every host running a Pihole this repo deploys (group_vars/pihole.yml).
[pihole:children]
dns

[all:vars]
ansible_user=${ansible_user}

# Managed by Ansible — edit the role template (or inventory/group_vars/all.yml's
# caddy_sites), not the file on the host.
#
# Global options: just the ACME account contact. DNS-01 is configured
# per-site below via an explicit `tls { issuer acme { dns cloudflare ...
# resolvers ... } } }` block — NOT the global `acme_dns` one-liner, and
# NOT the `tls { dns cloudflare ... \n resolvers ... }` shorthand either:
# `resolvers` is only wired up when nested inside an explicit
# `issuer acme { }` block — as a sibling of the top-level `dns` directive
# (global `acme_dns`) or of the shorthand per-site `tls { dns ... }` it's
# silently accepted by the parser but never reaches the running config
# (check with Caddy's admin API config dump; upstream issues
# caddyserver/caddy#4008 and #7192).
# `resolvers` matters because CoreDNS is authoritative for
# homelab.bcochofel.com (this VM's own system resolver), so without it
# pinned to public DNS, Caddy's ACME zone-cut discovery gets a real SOA
# answer from our own CoreDNS and never walks up to the actual Cloudflare
# zone (bcochofel.com) — fails with "expected 1 zone, got 0 for
# homelab.bcochofel.com" (see letsencrypt_dns_resolvers in
# group_vars/all.yml). Explicit `issuer acme` also drops Caddy's default
# ZeroSSL fallback issuer, so Let's Encrypt is the only issuer. {$VAR} is Caddyfile's own
# env-var placeholder syntax, resolved from the container's environment
# (.env, rendered separately from this file so the token is never
# templated directly into the Caddyfile).
{
    email {$LETSENCRYPT_EMAIL}
}

{% for site in caddy_sites %}
{% set need_transport = (site.insecure_skip_verify | default(false)) or (site.upstream_sni is defined) or (site.trusted_ca is defined) %}
{{ site.fqdn }} {
    tls {
        issuer acme {
            dns cloudflare {$CLOUDFLARE_API_TOKEN}
            resolvers {{ letsencrypt_dns_resolvers | join(' ') }}
        }
    }
{% if need_transport %}
    reverse_proxy {{ site.upstream }} {
        transport http {
{% if site.upstream_sni is defined %}
            # Upstream is addressed by IP, but presents a cert issued for
            # its own hostname (e.g. an already-TLS'd workloads backend,
            # cert managed by that backend's own repo/role) — without this,
            # Caddy verifies the backend cert against the bare IP by
            # default and fails with "certificate is valid for
            # {{ site.upstream_sni }}, not <ip>".
            tls_server_name {{ site.upstream_sni }}
{% endif %}
{% if site.trusted_ca is defined %}
            # Upstream's cert is issued by a private CA (caddy_trusted_cas):
            # verify it against that CA alone, rather than skip verification.
            tls_trust_pool file /etc/caddy/trust/{{ site.trusted_ca }}.crt
{% endif %}
{% if site.insecure_skip_verify | default(false) %}
            # Upstream presents a self-signed/internal cert — this only
            # weakens verification of the LAN hop to the backend, not the
            # public TLS Caddy itself terminates for clients.
            tls_insecure_skip_verify
{% endif %}
        }
    }
{% else %}
    reverse_proxy {{ site.upstream }}
{% endif %}
}

{% endfor %}

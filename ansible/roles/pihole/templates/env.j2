# Managed by Ansible. Read by Pihole at container start via env_file —
# deliberately never templated into docker-compose.yml directly, so
# `docker inspect`/`docker compose config` don't leak WEBPASSWORD the way
# a raw environment: entry in the compose file would (same pattern as
# Caddy's CLOUDFLARE_API_TOKEN).
#
# Confirmed against https://docs.pi-hole.net/docker/ (2026-08-12): Pi-hole
# v6 (FTL v6+) uses FTLCONF_<path> vars mapping onto pihole.toml, not the
# legacy WEBPASSWORD/DNS1/DNS2 vars. FTLCONF_dns_upstreams is `;`-delimited.
#
# Pihole is ad-blocking only now — CoreDNS is the sole source of truth for
# dns_zone (see roles/coredns). FTLCONF_dns_hosts is deliberately NOT
# rendered here any more (removed 2026-08-15) — dns_zone queries are
# conditionally forwarded to CoreDNS instead via dns.revServers
# (FTLCONF_dns_revServers, confirmed against
# https://docs.pi-hole.net/ftldns/configfile/, 2026-08-15): a
# CONF_JSON_STRING_ARRAY, `;`/`\n`-delimited, each entry
# "<enabled>,<ip-cidr>,<server>[#<port>][,<domain>]". Two entries below
# (primary + secondary CoreDNS) for redundancy. Known trade-off: Pihole
# previously auto-generated PTR (reverse) records for dns_hosts entries;
# removing FTLCONF_dns_hosts drops that, and CoreDNS's zone file has no
# reverse zone either, so PTR lookups for these hostnames resolve nowhere
# until/unless a reverse zone is added to CoreDNS.
#
# Rendered identically on both Pihole instances (server01 + pi3-01) — every
# var here comes from group_vars/all.yml or group_vars/pihole.yml, shared
# by both, not from the instance-specific group_vars/dns.yml or
# group_vars/pi3.yml. pihole_revserver_subnet (not dns_macvlan_subnet) is
# used deliberately: pi3-01 has no macvlan network at all.
TZ={{ pihole_timezone }}
FTLCONF_webserver_api_password={{ pihole_webpassword }}
FTLCONF_dns_upstreams={{ dns_forward_resolvers | join(';') }}
{% set rev_servers = [] %}
{% set _ = rev_servers.append('true,' ~ pihole_revserver_subnet ~ ',' ~ coredns_ip ~ '#53,' ~ dns_zone) %}
{% set _ = rev_servers.append('true,' ~ pihole_revserver_subnet ~ ',' ~ coredns_secondary_ip ~ '#53,' ~ dns_zone) %}
FTLCONF_dns_revServers={{ rev_servers | join(';') }}

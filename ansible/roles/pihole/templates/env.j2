# Managed by Ansible. Read by Pihole at container start via env_file —
# deliberately never templated into docker-compose.yml directly, so
# `docker inspect`/`docker compose config` don't leak WEBPASSWORD the way
# a raw environment: entry in the compose file would (same pattern as
# Caddy's CLOUDFLARE_API_TOKEN).
#
# Per https://docs.pi-hole.net/docker/: Pi-hole v6 (FTL v6+) uses
# FTLCONF_<path> vars mapping onto pihole.toml, not the legacy
# WEBPASSWORD/DNS1/DNS2 vars. FTLCONF_dns_upstreams is `;`-delimited.
#
# Pihole is ad-blocking only — CoreDNS is the sole source of truth for
# dns_zone (see roles/coredns). FTLCONF_dns_hosts is deliberately NOT
# rendered — dns_zone queries are conditionally forwarded to CoreDNS via
# dns.revServers (FTLCONF_dns_revServers, per
# https://docs.pi-hole.net/ftldns/configfile/): a CONF_JSON_STRING_ARRAY,
# `;`/`\n`-delimited, each entry
# "<enabled>,<ip-cidr>,<server>[#<port>][,<domain>]". Two entries below
# (primary + secondary CoreDNS) for redundancy. Known trade-off: Pihole
# doesn't auto-generate PTR (reverse) records for dns_hosts entries, and
# CoreDNS's zone file has no reverse zone, so PTR lookups for these
# hostnames resolve nowhere unless a reverse zone is added to CoreDNS.
#
# Every var here comes from group_vars/all.yml or group_vars/pihole.yml,
# never from dns.yml: the QNAP-hosted secondary (docs/EXTERNAL-DEPENDENCIES.md#pi-hole-secondary)
# copies these same values by hand, so they must stay instance-independent.
# pihole_revserver_subnet (not dns_macvlan_subnet) for the same reason: the
# secondary has no macvlan network.
TZ={{ pihole_timezone }}
FTLCONF_webserver_api_password={{ pihole_webpassword }}
FTLCONF_dns_upstreams={{ dns_forward_resolvers | join(';') }}
{% set rev_servers = [] %}
{% set _ = rev_servers.append('true,' ~ pihole_revserver_subnet ~ ',' ~ coredns_ip ~ '#53,' ~ dns_zone) %}
{% set _ = rev_servers.append('true,' ~ pihole_revserver_subnet ~ ',' ~ coredns_secondary_ip ~ '#53,' ~ dns_zone) %}
FTLCONF_dns_revServers={{ rev_servers | join(';') }}

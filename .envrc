# .envrc — committed. No plaintext secrets here.
export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"

# Decrypt once at root; children inherit via source_up.
# Runs in the human shell before any agent starts.
if [ -f secrets.yaml ]; then
  eval "$(sops -d --output-type dotenv secrets.yaml | sed 's/^/export /')"
fi

# Non-sensitive, shared across all three tools
export PROXMOX_NODE="pve1"
export PROXMOX_HOST="192.168.68.20"
export PROXMOX_ENDPOINT="https://${PROXMOX_HOST}:8006"

watch_file secrets.yaml
watch_file .sops.yaml

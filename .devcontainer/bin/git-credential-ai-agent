#!/usr/bin/env bash
# git credential helper for the devcontainer (docs/DEVCONTAINER.md): answers
# https://github.com with the AI agent's machine-user PAT, decrypted from
# ~/.secrets/ai-agent-git.yaml for this one call and never stored. Wired up
# by devcontainer.json's GIT_CONFIG_* entries; git calls it, nothing else
# should (.claude/settings.json denies running it directly).
set -euo pipefail

# Only "get": "store" and "erase" have nothing to do, the PAT stays in SOPS.
[ "${1:-}" = get ] || exit 0

protocol='' host=''
while IFS='=' read -r key value && [ -n "$key" ]; do
  case $key in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0

token=$(sops -d --extract '["GH_TOKEN"]' "$HOME/.secrets/ai-agent-git.yaml")
printf 'username=bcochofel-ai-agent\npassword=%s\n' "$token"
